local scenes = {"go#main-menu", "go#level-001"}

--- This will automatically load and unload scenes based on the scene passed in
---@param scene string the scene you want to load, ie. "go#main-menu"
local function load_scene(self, scene)
	for index, value in ipairs(scenes) do
		if value == scene then
			msg.post(value, "load")
			msg.post(value, "enable")
		else
			msg.post(value,"unload")
		end
	end
end

function init(self)
	msg.post(".", "acquire_input_focus")
	load_scene(self, "go#main-menu")
end

